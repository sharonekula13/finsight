# Copy to .env and fill in to enable live mode.
# Offline mode (default) needs none of these.

FINSIGHT_MODE=offline          # set to "live" to use real providers

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional retrieval tuning
FINSIGHT_TOP_K=4
FINSIGHT_CHUNK_SIZE=120
FINSIGHT_CHUNK_OVERLAP=30
FINSIGHT_DENSE_WEIGHT=0.6

# Real-filing ingestion (SEC requires contact info in the User-Agent)
SEC_USER_AGENT=Your Name your.email@example.com

# Safe settings for a first live run on a real 10-K (keeps embedding calls
# inside Gemini's free tier and fast):
#   FINSIGHT_CHUNK_SIZE=250
#   FINSIGHT_MAX_CHUNKS=200
FINSIGHT_MAX_CHUNKS=0
